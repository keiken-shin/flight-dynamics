# Secrets. .env holds the YouTube Data API key; .env.example is the template
# and IS tracked.
.env
.env.local

# Dependencies and build output — both reproducible from package-lock.json.
node_modules/
dist/

# Design process, not product. Screenshots, comps and sketches are how the build
# arrived at its direction; they run to ~33 MB, they date the moment anything
# moves, and nothing in the app reads them. What IS kept out of .impeccable is
# the design system itself: design.json (the detector reads it), the surface
# briefs, and the direction payload recording which direction was chosen.
.impeccable/shots/
.impeccable/sketches/
.impeccable/mocks/
.impeccable/questions/
.impeccable/hook.cache.json

# Generated imagery. The PLATES are imported by src/ui/home.js, so the build
# fails without them — they are tracked, and the exception is a glob rather than
# a filename because the rule is "a plate is imported, therefore a plate is
# tracked". Naming one file meant the second plate was ignored, built fine
# locally where it existed on disk, and broke the deploy.
# The hero images are not referenced by any page; they stay on disk and out of
# history, because adding 40 MB to a repo later is one commit while removing it
# later is a rewrite. Track them with `git add -f` if they should be versioned.
assets/generated/*.png
!assets/generated/plate-*.png

# Editor / OS noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
